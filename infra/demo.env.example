# ---------------------------------------------------------------------------
# Notification Platform PoC - environment
#
#   cp infra/demo.env.example infra/demo.env   and edit.
#
# infra/demo.env is gitignored: it names your SSH key and may hold a DNS token.
# Everything here has a working default except SSH_KEY and the host addresses.
# ---------------------------------------------------------------------------

# --- SSH ------------------------------------------------------------------
# Path to the private key for the EC2 instances you provision. Never commit it.
SSH_KEY=~/.ssh/my-poc-key.pem
SSH_USER=ubuntu

# --- Sizing ---------------------------------------------------------------
# Picks the memory quotas and replica count that setup-cluster.sh applies:
#
#   single  1 node, all services, ~8 GB RAM, 0 replicas (one node cannot host
#           a replica - the bucket create fails rather than degrading)
#   small   3 nodes, all services on each, ~16 GB - every feature, small data
#   full    the benchmarked 7-node layout; only this reproduces the numbers
#
# Individual quotas can still be overridden - see setup-cluster.sh.
PROFILE=small

# --- Couchbase ------------------------------------------------------------
# Deliberately the simplest possible credentials: this is a throwaway demo
# cluster in a private VPC, and every script takes these from the environment.
# Change them if your environment requires it - nothing hard-codes them.
CB_USER=Administrator
CB_PASS=password

# Bucket, scope and tenant. Change these and everything follows: the services
# read them from the environment, every N1QL query is built from them rather
# than hardcoded, setup-cluster.sh provisions to them, and infra/apply-configs.sh
# substitutes them into the FTS, Sync Gateway and Eventing definitions.
#
# The seeder takes the same values (--bucket, --scope, --tenant) and writes
# tenant_id into every document and document key, so pick them before seeding:
# changing the tenant afterwards means rewriting every key.
CB_BUCKET=ncgr
CB_SCOPE=platform
TENANT_ID=ncgr

# --- Hosts ----------------------------------------------------------------
# PRIVATE addresses survive an AWS stop/start; public ones do not. Use private
# addresses for anything inside the VPC (the pipeline reaching Couchbase, Sync
# Gateway reaching Couchbase) and reserve the public ones for your own access.
CB_HOST_PRIVATE=192.168.0.10        # a data node; the pipeline bootstraps here
CB_HOST_PUBLIC=                     # for the 8091 UI from your laptop
APP_HOST_PUBLIC=                    # dashboard :3000, pipeline API :8080

# --- Optional: DuckDNS ----------------------------------------------------
# RECOMMENDED, not required.
#
# Without Elastic IPs, every instance stop/start hands out new public addresses.
# That is merely annoying for the dashboard, but expensive for Keycloak: its
# address is baked into KC_HOSTNAME, which mints the OIDC `iss` claim, which
# must match Sync Gateway's stored issuer - and changing that means a config PUT
# that restarts the full import scan of the notifications collection.
#
# A free DuckDNS name (https://www.duckdns.org, 5 subdomains per account) makes
# every address stable. Each host then repoints its own record at boot, so a
# restart needs no intervention at all. See infra/duckdns/README.md.
#
# Leave DUCKDNS_TOKEN empty to skip it and work with raw IPs. Everything still
# works; you will just re-edit addresses after each restart.
DUCKDNS_TOKEN=
DUCKDNS_CB=                         # e.g. mypoc-cb
DUCKDNS_APP=                        # e.g. mypoc-app
DUCKDNS_KC=                         # e.g. mypoc-kc    (phase 2, mobile only)
DUCKDNS_SG=                         # e.g. mypoc-sg    (phase 2, mobile only)

# --- Optional: phase 2, mobile sync --------------------------------------
# Only needed if you build the Couchbase Lite / Sync Gateway half.
KC_REALM=myrealm
KC_CLIENT_ID=ncgrdemo
KC_ADMIN=admin
KC_ADMIN_PASSWORD=password
