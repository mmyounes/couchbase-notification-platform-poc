# Copy to infra/.env on the deployment host and fill in.
# NEVER commit the real .env - it holds the cluster password.
# Note: `rsync --delete` from a workstation will remove infra/.env on the host
# unless you exclude it; this file exists so the shape is at least recoverable.
CB_HOST=192.168.16.113
CB_USER=Administrator
CB_PASS=changeme
LOG_LEVEL=warn
