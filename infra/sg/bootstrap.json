{
  "bootstrap": {
    "server": "couchbase://192.168.16.113",
    "username": "Administrator",
    "password": "<set on the host; not stored in git>",
    "server_tls_skip_verify": true,
    "use_tls_server": false
  },
  "api": {
    "public_interface": ":4984",
    "admin_interface": "127.0.0.1:4985",
    "cors": {
      "origin": [
        "*"
      ],
      "login_origin": [],
      "headers": [
        "Content-Type",
        "Authorization",
        "Accept"
      ],
      "max_age": 1728000
    }
  },
  "logging": {
    "console": {
      "log_level": "info",
      "log_keys": [
        "HTTP",
        "Auth",
        "Import"
      ]
    }
  }
}
